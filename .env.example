# Environment variables for Full-Stack AI Apps
# Copy this file to .env and fill in your actual values

# === Application Settings ===
NODE_ENV=development
ENVIRONMENT=dev
DEBUG=true
PORT=8000
API_VERSION=v1

# === Cloud Provider Regions ===
AWS_REGION=us-east-1
GCP_REGION=us-central1
AZURE_LOCATION=East US

# === AWS Configuration ===
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BEDROCK_REGION=us-east-1
AWS_SAGEMAKER_EXECUTION_ROLE=arn:aws:iam::123456789012:role/SageMakerExecutionRole

# === Google Cloud Configuration ===
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/gcp-service-account.json
GCP_PROJECT_ID=your-gcp-project-id

# === Azure Configuration ===
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key

# === Vercel Configuration ===
VERCEL_TOKEN=your_vercel_token
VERCEL_PROJECT_ID=your_vercel_project_id

# === Database Configuration ===
DATABASE_URL=postgresql://ai_user:ai_password@localhost:5432/fullstack_ai
REDIS_URL=redis://localhost:6379

# === Vector Database Configuration ===
# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east1-gcp

# Chroma
CHROMA_DB_PATH=./chroma_db
CHROMA_SERVER_URL=http://localhost:8001

# Weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your_weaviate_api_key

# === AI Model Configuration ===
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
COHERE_API_KEY=your_cohere_api_key

# === Embedding Models ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# === Security Configuration ===
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_32_chars_long
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
ALLOWED_HOSTS=localhost,your-domain.com

# === Monitoring Configuration ===
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# === MLOps Configuration ===
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=your_s3_endpoint
WANDB_API_KEY=your_wandb_api_key

# === Logging Configuration ===
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log

# === Feature Flags ===
ENABLE_RAG=true
ENABLE_AGENTS=true
ENABLE_MCP=true
ENABLE_MONITORING=true
ENABLE_AUTHENTICATION=false

# === Performance Settings ===
MAX_WORKERS=4
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=10MB
RATE_LIMIT_PER_MINUTE=60

# === Development Settings (only for development) ===
HOT_RELOAD=true
DEBUG_SQL=false
MOCK_AI_SERVICES=false